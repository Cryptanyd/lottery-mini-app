# ---------- Server-side (never exposed to the browser) ----------
# Solana RPC used by API routes. Public mainnet works but is rate-limited.
# Recommended: Helius free tier -> https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Secret used to sign Pro licenses (HMAC-SHA256). Generate: openssl rand -hex 32
LICENSE_SECRET=change-me-to-a-long-random-string

# ---------- Public (exposed to the browser) ----------
# RPC used by the wallet adapter to send the Pro payment transaction.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Wallet that receives Pro subscription payments. Leave empty to disable payments.
NEXT_PUBLIC_TREASURY_ADDRESS=

# Price of 30 days of Pro, in SOL.
NEXT_PUBLIC_PRO_PRICE_SOL=0.2

# Canonical site URL (used for metadata / share links).
NEXT_PUBLIC_SITE_URL=https://scanx.app
