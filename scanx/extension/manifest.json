{
  "manifest_version": 3,
  "name": "ScanX — Solana CA Scanner for X",
  "short_name": "ScanX",
  "version": "0.3.0",
  "description": "Instant risk check for Solana contract addresses in tweets: authorities, holders, liquidity, age — right inside X.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ScanX",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.dexscreener.com/*",
    "https://lite-api.jup.ag/*",
    "https://api.mainnet-beta.solana.com/*",
    "https://mainnet.helius-rpc.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*", "https://mobile.twitter.com/*"],
      "js": [
        "src/shared/config.js",
        "src/shared/solana.js",
        "src/shared/risk.js",
        "src/content/detector.js",
        "src/content/card.js",
        "src/content/content.js"
      ],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
